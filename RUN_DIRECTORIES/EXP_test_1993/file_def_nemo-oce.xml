<?xml version="1.0"?>

    <!-- 
============================================================================================================
=                                           output files definition                                        =
=                                            Define your own files                                         =
=                                         put the variables you want...                                    =
============================================================================================================
    -->
    
    <!-- Adapted from eAMM7: EOS-80 tracers; PEA/PEAT unavailable in this build. -->
    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="10d" min_digits="4">
    
      <file_group id="1ts" output_freq="1ts"  output_level="10" enabled=".TRUE."> <!-- 1 time step files -->
      </file_group>

      <file_group id="20mi" output_freq="20mi"  output_level="10" enabled=".TRUE."> <!-- 20m files -->
      </file_group>

         <!-- TMB files -->
      <file_group id="1h" output_freq="1h"  output_level="10" enabled=".TRUE."  >

   <file id="file9" name_suffix="_shelftmb_grid_T" description="ocean T grid variables" enabled=".TRUE." >
     <field field_ref="ssh"         name="sossheig"       operation="instant" enabled=".TRUE." />
      <field field_ref="sst_pot"           name="votemper_top" operation="average" />
      <field field_ref="sbt_pot"           name="votemper_bot" operation="average" />
      <field field_ref="sss_pra"            name="vosaline_top" operation="average" />
      <field field_ref="sbs_pra"            name="vosaline_bot" operation="average" />
   </file>

   <file id="file10" name_suffix="_shelftmb_grid_U" description="TMB ocean U grid variables" enabled=".TRUE." >
     <field field_ref="baro_u"        name="vobtcrtx"       operation="instant" />
   </file>

   <file id="file11" name_suffix="_shelftmb_grid_V" description="TMB ocean V grid variables" enabled=".TRUE." >
     <field field_ref="baro_v"        name="vobtcrty"       operation="instant" />
   </file>
      </file_group>
      <file_group id="25h_mean" output_freq="1d" output_level="10" enabled=".TRUE.">

         <file id="file12" name_suffix="_25hourm_grid_T" description="ocean T grid variables, 25h meaned" enabled=".TRUE." >
            <field field_ref="temper25h"   name="votemper"  unit="degC"  operation="instant" enabled=".TRUE."/>
            <field field_ref="salin25h"    name="vosaline"  unit="psu"     operation="instant" enabled=".TRUE."/>
            <field field_ref="ssh25h"      name="sossheig"  unit="m"     operation="instant" enabled=".TRUE."/>
        </file>
        <file id="file13" name_suffix="_25hourm_grid_U" description="ocean U grid variables, 25h meaned" enabled=".TRUE." >
           <field field_ref="vozocrtx25h" name="vozocrtx"  operation="instant" enabled=".TRUE."/>
        </file>
        <file id="file14" name_suffix="_25hourm_grid_V" description="ocean V grid variables, 25h meaned" enabled=".TRUE." >
           <field field_ref="vomecrty25h" name="vomecrty"  operation="instant" enabled=".TRUE."/>
        </file>
	<file id="file15" name_suffix="_25hourm_grid_W" description="ocean W grid variables, 25h meaned" enabled=".TRUE." >
           <field field_ref="vovecrtz25h" name="vovecrtz"  operation="instant" enabled=".TRUE."/>
        </file>
    </file_group>

      <file_group id="1d" output_freq="1d"  output_level="10" enabled=".TRUE."> <!-- 1d files -->

        <file id="file1" name_suffix="_grid_T" description="ocean T grid variables" >
          <field field_ref="mldkz5"                        operation="average" />
          <field field_ref="mldr10_1"                      operation="average" />
          <field field_ref="empmr"        name="wfo"       operation="average" />
          <field field_ref="qsr_oce"      name="qsr_oce"   operation="average" />
          <field field_ref="qns_oce"      name="qns_oce"   operation="average" />
          <field field_ref="qt_oce"       name="qt_oce"    operation="average" />
          <field field_ref="saltflx"      name="sfx"       operation="average" />
          <field field_ref="taum"         name="taum"      operation="average" />
          <field field_ref="wspd"         name="windsp"    operation="average" />
          <field field_ref="precip"       name="precip"    operation="average" />
        </file>

    </file_group>
      
      <file_group id="3d" output_freq="3d"  output_level="10" enabled=".TRUE."/> <!-- 3d files -->
      <file_group id="5d" output_freq="5d"  output_level="10" enabled=".TRUE."/> <!-- 5d files -->   
      <file_group id="1m" output_freq="1mo" output_level="10" enabled=".TRUE."> <!-- real monthly files -->
        <file id="file21" name_suffix="_grid_T" description="ocean T grid variables" >
          <field field_ref="e3t"                           operation="average" />
	   <field field_ref="toce_pot"     name="toce_pot"   long_name="mean_sea_water_potential_temperature"  operation="average" />
           <field field_ref="soce_pra"     name="soce_pra"   long_name="mean_sea_water_practical_salinity"           operation="average" />
          <field field_ref="ssh"          name="ssh"       operation="average" />
        </file>

       <file id="file22" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="e3u" operation="average" />
          <field field_ref="uoce"         name="uo"    operation="average"   />
          <field field_ref="utau"         name="tauuo"   operation="average"  />
        </file>

       <file id="file23" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="e3v" operation="average" />
          <field field_ref="voce"         name="vo"       operation="average" />
          <field field_ref="vtau"         name="tauvo"    operation="average" />
        </file>

        <file id="file24" name_suffix="_grid_W" description="ocean W grid variables" >
          <field field_ref="e3w" operation="average" />
          <field field_ref="woce"         name="wo"       operation="average" />
          <field field_ref="avt"          name="difvho"   operation="average" />
          <field field_ref="avm"          name="avm"      operation="average" />
        </file>

      </file_group>
      <file_group id="2y"  output_freq="2y" output_level="10" enabled=".TRUE."/> <!-- real 2y files -->
      <file_group id="5y"  output_freq="5y" output_level="10" enabled=".TRUE."/> <!-- real 5y files -->
      <file_group id="10y" output_freq="10y" output_level="10" enabled=".TRUE."/> <!-- real 10y files -->

   </file_definition>
    
